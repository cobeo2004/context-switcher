{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["src/worker.ts", "src/panel.tsx", "src/protocol.ts", "src/panel.check.ts", "src/**/*.test.{ts,tsx}", "scripts/*.mjs"],
