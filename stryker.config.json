{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": { "command": "H=$(mktemp -d) && HOME=$H FC_SEED=42 orca plugin test ." },
  "mutate": ["src/context.ts", "src/store.ts"],
  "coverageAnalysis": "off",
  "ignorePatterns": [".orca", ".sstack", "reports", ".stryker-tmp", "src/threadRead.handoff.test.ts"],
  "reporters": ["clear-text", "progress", "json", "html"],
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },
  "htmlReporter": { "fileName": "reports/mutation/mutation.html" },
  "concurrency": 4,
  "timeoutMS": 5000,
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": "always",
  "thresholds": { "high": 97, "low": 95, "break": 94 }
}
